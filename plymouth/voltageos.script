Window.SetBackgroundTopColor(0.063, 0.035, 0.059);
Window.SetBackgroundBottomColor(0.008, 0.004, 0.008);

screen_width = Window.GetWidth();
screen_height = Window.GetHeight();

panel_y = screen_height * 0.42;

bgrt_image = Image("/sys/firmware/acpi/bgrt/image");
bgrt_logo = Sprite(bgrt_image);
bgrt_logo.SetPosition((screen_width - bgrt_image.GetWidth()) / 2,
                      panel_y - bgrt_image.GetHeight() - screen_height * 0.025, 20);
bgrt_logo.SetOpacity(0.96);

logo_image = Image("logo.png");
logo_width = screen_width * 0.42;
logo_height = logo_image.GetHeight() * logo_width / logo_image.GetWidth();
logo_image = logo_image.Scale(logo_width, logo_height);
logo = Sprite(logo_image);
logo_y = panel_y + screen_height * 0.015;
logo.SetPosition((screen_width - logo_width) / 2, logo_y, 20);
logo.SetOpacity(0.96);

status = Label("Starting system");
status.SetPosition(screen_width / 2, logo_y + logo_height + screen_height * 0.055, 20);
status.SetAlignment(0.5, 0.5);
status.SetColor(1.0, 0.23, 0.37);

fun message_callback(message) {
  status.SetText(message);
}

Plymouth.SetMessageFunction(message_callback);
