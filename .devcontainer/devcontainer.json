{
  "name": "voltage!os Arch Linux",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "runArgs": [
    "--privileged"
  ],
  "forwardPorts": [
    6080
  ],
  "remoteUser": "vscode",
  "containerUser": "vscode",
  "postCreateCommand": "sudo pacman -Syu --needed --noconfirm",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-containers"
      ]
    }
  }
}
